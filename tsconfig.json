{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@semantic-gate/contract": [
        "packages/contract/src/index.ts"
      ],
      "@semantic-gate/datalog": [
        "packages/datalog/src/index.ts"
      ],
      "@semantic-gate/semtrans": [
        "packages/semtrans/src/index.ts"
      ],
      "@semantic-gate/viz": [
        "packages/viz/src/index.ts"
      ],
      "@semantic-gate/client": [
        "packages/client/src/index.ts"
      ],
      "@semantic-gate/client/node": [
        "packages/client/src/node.ts"
      ],
      "@semantic-gate/client/browser": [
        "packages/client/src/browser.ts"
      ]
    },
    "erasableSyntaxOnly": true
  },
  "include": [
    "packages/*/src",
    "examples/**/*.ts"
  ]
}
